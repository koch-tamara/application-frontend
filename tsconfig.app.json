{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "outDir": "./out-tsc/app",
    "composite": true,
    "types": [
      "@angular/localize"
    ]
  },
  "files": [
    "src/main.ts"
  ],
  "include": [
    "src/**/*.ts",
    "projects/**/*.ts"
  ],
  "exclude": [
    "src/**/*.spec.ts",
    "projects/**/*.spec.ts"
  ]
}